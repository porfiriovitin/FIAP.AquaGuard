# Mapbox public token — create a RESTRICTED token at https://account.mapbox.com/access-tokens/
# Steps:
#   1. Click "Create a token"
#   2. Scopes: check only "styles:read" and "tiles:read"
#   3. Allowed URLs: add your localhost, ngrok domain, and production domain
#   4. Copy the generated pk.* token below
VITE_MAPBOX_TOKEN=pk.INSERT_YOUR_RESTRICTED_TOKEN_HERE

# Backend API base URL (sem trailing slash)
# Exemplo: http://localhost:5000 (dev) ou https://api.aquaguard.com (prod)
VITE_API_BASE_URL=http://localhost:5000

# Should use mock data
VITE_MOCK_DATA=true